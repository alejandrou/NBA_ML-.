DATABASE_URL=postgresql+psycopg://nba:nba@localhost:5432/nba
DATABASE_CONNECT_TIMEOUT_SECONDS=5
API_READINESS_TIMEOUT_SECONDS=2
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba
POSTGRES_DB=nba
POSTGRES_HOST=localhost
# Host interface the database port is published on. 127.0.0.1 keeps it reachable
# from this machine only; widening it (for example 0.0.0.0) exposes the database
# to every network this host is on.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
SCRAPER_USER_AGENT=nba-data-project/0.1 contact:your-email@example.com
SCRAPER_MAX_REQUESTS_PER_MINUTE=10
# Hard floor. Anything below 6 is rejected at startup.
SCRAPER_MIN_DELAY_SECONDS=6
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_CACHE_DIR=data/raw/html
SCRAPER_FORCE_REFRESH=false
APP_ENV=local
LOG_LEVEL=INFO
